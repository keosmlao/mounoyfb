// FBMONOY — ລະບົບຈັດການການຍິງໂຄສະນາ Facebook
// ໂຄງສ້າງອອກແບບໃຫ້ປ້ອນມືໄດ້ 100% ແລະ ພ້ອມຮັບ sync ຈາກ Facebook Marketing API
// ພາຍຫຼັງ (ທຸກຕາຕະລາງທີ່ map ກັບ FB ມີຊ່ອງ fb*Id ໄວ້ upsert).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EntityStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignObjective {
  MESSAGES // ຂໍ້ຄວາມ (Messenger)
  TRAFFIC // ດຶງຄົນເຂົ້າເວັບ
  ENGAGEMENT // ການມີສ່ວນຮ່ວມ
  LEADS // ເກັບລາຍຊື່ລູກຄ້າ
  SALES // ຍອດຂາຍ / Conversion
  AWARENESS // ການຮັບຮູ້ແບຣນ
  VIDEO_VIEWS // ຍອດເບິ່ງວິດີໂອ
  APP_PROMOTION // ໂປຣໂມດແອັບ
}

enum InsightLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
}

enum DataSource {
  MANUAL // ປ້ອນມື
  API // sync ຈາກ Facebook Marketing API
}

enum LeadStatus {
  NEW // ໃໝ່
  CONTACTED // ຕິດຕໍ່ແລ້ວ
  QUALIFIED // ສົນໃຈຈິງ
  WON // ປິດການຂາຍໄດ້
  LOST // ຫຼຸດ
}

/// ສະຖານະອໍເດີຈິງຂອງຮ້ານ — ແຍກຈາກ purchase ທີ່ Facebook ລາຍງານ
enum OrderStatus {
  PENDING // ລໍຖ້າຢືນຢັນ
  CONFIRMED // ຢືນຢັນແລ້ວ
  SHIPPED // ສົ່ງອອກແລ້ວ
  DELIVERED // ລູກຄ້າຮັບສຳເລັດ — ນັບເປັນຍອດຂາຍຈິງ
  RETURNED // ຕີກັບ
  CANCELLED // ຍົກເລີກ
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// ມິຕິທີ່ Facebook ແຍກຜົນໃຫ້ — ໃຊ້ຫາວ່າກຸ່ມໃດ/ບ່ອນໃດ/ເວລາໃດ ຄຸ້ມທີ່ສຸດ
enum SegmentKind {
  AGE_GENDER // ອາຍຸ + ເພດ
  PLATFORM // FB/IG + ຕຳແໜ່ງ (feed / reels / story)
  REGION // ແຂວງ
  HOUR // ຊົ່ວໂມງໃນມື້ (ຕາມເຂດເວລາຂອງບັນຊີ)
}

// ---------------------------------------------------------------------------
// ບັນຊີໂຄສະນາ / ເພຈ / ສິນຄ້າ
// ---------------------------------------------------------------------------

/// ບັນຊີໂຄສະນາ (Ad Account) — 1 ບັນຊີ = 1 ກະເປົາເງິນທີ່ຕັດຄ່າໂຄສະນາ
model AdAccount {
  id          String       @id @default(cuid())
  /// act_XXXXXXXXX ຈາກ Facebook (ວ່າງໄດ້ ຖ້າຍັງບໍ່ຕໍ່ API)
  fbAccountId String?      @unique
  name        String
  /// ສະກຸນເງິນທີ່ Facebook ຕັດຈາກບັນຊີນີ້ — ປົກກະຕິ USD
  currency    String       @default("USD")
  timezone    String       @default("Asia/Vientiane")
  /// ເພດານທີ່ **ຜູ້ໃຊ້ຕັ້ງເອງ** ໄວ້ເຕືອນ — ຄົນລະອັນກັບ `fbSpendCap`
  spendCap    Float?
  status      EntityStatus @default(ACTIVE)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // --- ຂໍ້ມູນການຊຳລະຈາກ Facebook — ອ່ານຢ່າງດຽວ, ຖືກທັບທຸກເທື່ອທີ່ນຳເຂົ້າ ---
  /// ວິທີຊຳລະທີ່ຜູກໄວ້ ເຊັ່ນ "Mastercard *7447"
  fbFundingSource String?
  /// ຍອດທີ່ຍັງບໍ່ທັນຖືກຮຽກເກັບ — ສະກຸນຂອງບັນຊີ (`currency`) ບໍ່ແມ່ນກີບ
  fbBalance       Float?
  /// ໃຊ້ໄປແລ້ວທັງໝົດຕັ້ງແຕ່ເປີດບັນຊີ — ສະກຸນຂອງບັນຊີ ບໍ່ແມ່ນກີບ
  fbAmountSpent   Float?
  /// ເພດານທີ່ຕັ້ງໄວ້ຝັ່ງ Facebook (0 = ບໍ່ໄດ້ຕັ້ງ) — ສະກຸນຂອງບັນຊີ
  fbSpendCap      Float?
  /// ບັນຊີທຸລະກິດ (Business Manager) ທີ່ເປັນເຈົ້າຂອງບັນຊີໂຄສະນານີ້
  fbBusinessName  String?
  /// ເວລາທີ່ດຶງຂໍ້ມູນການຊຳລະຄັ້ງລ້າສຸດ — ວ່າງ = ຍັງບໍ່ເຄີຍນຳເຂົ້າ
  fbBillingAt     DateTime?

  campaigns Campaign[]
  insights  Insight[]
  segments  SegmentInsight[]

  @@index([status])
}

/// ເພຈ Facebook ທີ່ໃຊ້ຍິງໂຄສະນາ
model FbPage {
  id        String       @id @default(cuid())
  fbPageId  String?      @unique
  name      String
  category  String?
  status    EntityStatus @default(ACTIVE)
  note      String?
  /// Page access token — ຕ້ອງມີຈຶ່ງອ່ານ/ຕອບ comment ແລະ ແຊັດຂອງເພຈນີ້ໄດ້
  /// (token ຫຼັກຢູ່ AppSetting ໃຊ້ໄດ້ແຕ່ຝັ່ງໂຄສະນາ)
  token     String?
  /// ດຶງ comment/ແຊັດຂອງເພຈນີ້ນຳບໍ່ — ປິດໄວ້ໄດ້ສຳລັບເພຈທີ່ບໍ່ໄດ້ໃຊ້ແລ້ວ
  inboxOn   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  campaigns Campaign[]
  posts     FbPost[]
  comments  FbComment[]
  threads   FbThread[]
}

/// ສິນຄ້າ / ອອບເຟີ ທີ່ຍິງໂຄສະນາ — ໃຊ້ຄິດກຳໄລ ແລະ ROAS
model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  /// ລາຄາຂາຍ (ສະກຸນຫຼັກ = LAK)
  price     Float    @default(0)
  /// ຕົ້ນທຶນ (ສະກຸນຫຼັກ = LAK)
  cost      Float    @default(0)
  imageUrl  String?
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  leads     Lead[]
  orders    Order[]
}

// ---------------------------------------------------------------------------
// ໂຄງສ້າງໂຄສະນາ: Campaign > AdSet > Ad
// ---------------------------------------------------------------------------

model Campaign {
  id             String            @id @default(cuid())
  fbCampaignId   String?           @unique
  adAccountId    String
  pageId         String?
  productId      String?
  name           String
  objective      CampaignObjective @default(MESSAGES)
  status         EntityStatus      @default(ACTIVE)
  buyingType     String            @default("AUCTION")
  dailyBudget    Float?
  lifetimeBudget Float?
  startDate      DateTime?         @db.Date
  endDate        DateTime?         @db.Date
  /// ຜູ້ຮັບຜິດຊອບ (media buyer) — ຂໍ້ຄວາມທຳມະດາ ເພາະຍັງບໍ່ມີລະບົບ login
  ownerName      String?
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  adAccount AdAccount        @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  page      FbPage?          @relation(fields: [pageId], references: [id], onDelete: SetNull)
  product   Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  adSets    AdSet[]
  insights  Insight[]
  segments  SegmentInsight[]
  leads     Lead[]
  orders    Order[]
  posts     FbPost[]

  @@index([adAccountId])
  @@index([status])
  @@index([productId])
}

model AdSet {
  id               String       @id @default(cuid())
  fbAdSetId        String?      @unique
  campaignId       String
  name             String
  status           EntityStatus @default(ACTIVE)
  dailyBudget      Float?
  lifetimeBudget   Float?
  bidAmount        Float?
  optimizationGoal String?
  billingEvent     String?
  /// ກຸ່ມເປົ້າໝາຍ (ອາຍຸ / ເພດ / ພື້ນທີ່ / ຄວາມສົນໃຈ) — ບັນທຶກເປັນຂໍ້ຄວາມ
  audience         String?
  placements       String?
  startDate        DateTime?    @db.Date
  endDate          DateTime?    @db.Date
  note             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]
  insights Insight[]
  leads    Lead[]
  orders   Order[]

  @@index([campaignId])
  @@index([status])
}

model Ad {
  id           String       @id @default(cuid())
  fbAdId       String?      @unique
  adSetId      String
  name         String
  status       EntityStatus @default(ACTIVE)
  /// IMAGE / VIDEO / CAROUSEL / COLLECTION
  creativeType String?
  creativeUrl  String?
  postUrl      String?
  headline     String?
  primaryText  String?
  callToAction String?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  adSet    AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  insights Insight[]
  leads    Lead[]
  orders   Order[]

  @@index([adSetId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ຜົນການຍິງລາຍວັນ (ຫົວໃຈຂອງລະບົບ)
// ---------------------------------------------------------------------------

/// ຜົນລາຍວັນ 1 ແຖວ = 1 ວັນ ຕໍ່ 1 ອົງປະກອບ (account / campaign / adset / ad)
/// entityKey ຖືກສ້າງອັດຕະໂນມັດເປັນ "<LEVEL>:<id>" ເພື່ອກັນການປ້ອນຊ້ຳໃນວັນດຽວກັນ
model Insight {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  level       InsightLevel @default(CAMPAIGN)
  entityKey   String
  adAccountId String
  campaignId  String?
  adSetId     String?
  adId        String?

  /// ສະກຸນເງິນຂອງຄ່າໃຊ້ຈ່າຍ (ຕາມບັນຊີໂຄສະນາ)
  currency    String @default("USD")
  /// ອັດຕາແລກປ່ຽນເປັນ LAK ໃນວັນນັ້ນ — spend * fxRateToLak = ຄ່າໃຊ້ຈ່າຍເປັນກີບ
  fxRateToLak Float  @default(1)

  spend       Float @default(0)
  /// ຄ່າໃຊ້ຈ່າຍແປງເປັນກີບແລ້ວ (spend * fxRateToLak) — ຄິດໄວ້ຕອນບັນທຶກ ເພື່ອລວມຍອດໄດ້ໄວ
  spendLak    Float @default(0)
  impressions Int   @default(0)
  reach       Int   @default(0)
  clicks      Int   @default(0)
  linkClicks  Int   @default(0)
  /// ຈຳນວນຄົນທັກແຊັດ (ສຳຄັນທີ່ສຸດສຳລັບຕະຫຼາດລາວ)
  messages    Int   @default(0)
  leadsCount  Int   @default(0)
  purchases   Int   @default(0)
  /// ຍອດຂາຍທີ່ໄດ້ (LAK)
  revenue     Float @default(0)
  videoViews  Int   @default(0)

  source    DataSource @default(MANUAL)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet     AdSet?    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad        Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([date, entityKey])
  @@index([date])
  @@index([adAccountId, date])
  @@index([campaignId, date])
  @@index([source])
}

/// ຜົນແຍກຕາມກຸ່ມ (ອາຍຸ/ເພດ, ບ່ອນວາງ, ແຂວງ, ຊົ່ວໂມງ) — ເກັບແຍກຕາຕະລາງກັບ Insight
/// **ຢ່າເອົາໄປລວມກັບ Insight** ເພາະເປັນຕົວເລກອັນດຽວກັນທີ່ຖືກຫັ່ນຄົນລະແບບ
/// (ບວກ AGE_GENDER ກັບ REGION ຈະໄດ້ 2 ເທົ່າ). ໃຊ້ສະເພາະການວິເຄາະພາຍໃນມິຕິດຽວກັນ.
model SegmentInsight {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  kind        SegmentKind
  /// ຄ່າດິບຈາກ Facebook ເຊັ່ນ "18-24|female", "facebook|feed", "21" — ກະແຈກັນຊ້ຳ
  segKey      String
  adAccountId String
  campaignId  String

  currency    String @default("USD")
  fxRateToLak Float  @default(1)

  spend       Float @default(0)
  spendLak    Float @default(0)
  impressions Int   @default(0)
  reach       Int   @default(0)
  clicks      Int   @default(0)
  linkClicks  Int   @default(0)
  messages    Int   @default(0)
  leadsCount  Int   @default(0)
  purchases   Int   @default(0)
  revenue     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([date, kind, segKey, campaignId])
  @@index([kind, date])
  @@index([campaignId, kind])
}

// ---------------------------------------------------------------------------
// ລູກຄ້າທີ່ໄດ້ຈາກໂຄສະນາ
// ---------------------------------------------------------------------------

model Lead {
  id         String     @id @default(cuid())
  date       DateTime   @db.Date
  name       String
  phone      String?
  fbName     String?
  /// ຊ່ອງທາງ: Messenger / Comment / Lead Form / WhatsApp / ໂທ
  channel    String?
  status     LeadStatus @default(NEW)
  /// ຍອດຊື້ (LAK) — ໃສ່ເມື່ອປິດການຂາຍໄດ້
  amount     Float      @default(0)
  assignee   String?
  note       String?
  campaignId String?
  adSetId    String?
  adId       String?
  productId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adSet    AdSet?      @relation(fields: [adSetId], references: [id], onDelete: SetNull)
  ad       Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)
  product  Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders   Order[]
  comments FbComment[]
  threads  FbThread[]

  @@index([date])
  @@index([status])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// ອໍເດີ / ຍອດຂາຍຈິງ
// ---------------------------------------------------------------------------

/// Order ແມ່ນແຫຼ່ງຄວາມຈິງຂອງຍອດຂາຍໃນຮ້ານ.
/// ລາຄາ ແລະ ຕົ້ນທຶນຖືກ snapshot ຕອນສ້າງ ເພື່ອໃຫ້ລາຍງານເກົ່າ
/// ບໍ່ປ່ຽນຕາມເມື່ອແກ້ລາຄາ Product ໃນພາຍຫຼັງ.
model Order {
  id           String      @id @default(cuid())
  orderNo      String?     @unique
  date         DateTime    @db.Date
  status       OrderStatus @default(PENDING)
  customerName String
  phone        String?
  channel      String?
  quantity     Int         @default(1)

  /// ຍອດທີ່ຂາຍໃຫ້ລູກຄ້າຫຼັງສ່ວນຫຼຸດ (LAK)
  saleAmount   Float @default(0)
  /// ຕົ້ນທຶນສິນຄ້າລວມຂອງອໍເດີ (LAK)
  productCost  Float @default(0)
  shippingCost Float @default(0)
  otherCost    Float @default(0)
  /// ເງິນຄືນບາງສ່ວນສຳລັບອໍເດີທີ່ສົ່ງສຳເລັດ
  refundAmount Float @default(0)

  trackingNo String?
  note       String?
  leadId     String?
  productId  String?
  campaignId String?
  adSetId    String?
  adId       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adSet    AdSet?    @relation(fields: [adSetId], references: [id], onDelete: SetNull)
  ad       Ad?       @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status, date])
  @@index([campaignId, date])
  @@index([productId, date])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// ຕັ້ງຄ່າ / ອັດຕາແລກປ່ຽນ / ບັນທຶກ sync
// ---------------------------------------------------------------------------

/// ອັດຕາແລກປ່ຽນລາຍວັນ → LAK
model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  currency  String
  rateToLak Float
  createdAt DateTime @default(now())

  @@unique([date, currency])
  @@index([currency, date])
}

// ---------------------------------------------------------------------------
// ກ່ອງຂໍ້ຄວາມຂອງເພຈ: comment ແລະ ແຊັດ (Messenger)
// ---------------------------------------------------------------------------

/// ໂພສທີ່ມີ comment — ທັງໂພສທຳມະດາໃນເພຈ ແລະ ໂພສໂຄສະນາ (dark post)
/// ໂພສໂຄສະນາບໍ່ຢູ່ໃນໜ້າເພຈ ຈຶ່ງຕ້ອງຫາຜ່ານ `effective_object_story_id` ຂອງ ad
model FbPost {
  id         String    @id @default(cuid())
  fbPostId   String    @unique
  pageId     String
  /// ໂພສນີ້ຖືກໃຊ້ຍິງໂຄສະນາ (ບໍ່ໄດ້ໂພສລົງໜ້າເພຈ)
  fromAd     Boolean   @default(false)
  campaignId String?
  message    String?
  permalink  String?
  postedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  page     FbPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  comments FbComment[]

  @@index([pageId])
  @@index([campaignId])
  @@index([postedAt])
}

/// comment ດຽວ (ລວມທັງຄຳຕອບໃຕ້ comment) — `fromPage` ແຍກສຽງຂອງເຮົາເອງອອກ
model FbComment {
  id          String    @id @default(cuid())
  fbCommentId String    @unique
  postId      String
  pageId      String
  /// comment ແມ່ຂອງມັນ (ວ່າງ = comment ຊັ້ນເທິງສຸດ)
  parentFbId  String?
  fromId      String?
  fromName    String?
  message     String?
  attachment  String?
  likeCount   Int       @default(0)
  /// ເພຈເປັນຄົນຂຽນເອງ (ຄຳຕອບຂອງເຮົາ) — ບໍ່ນັບເປັນວຽກຄ້າງ
  fromPage    Boolean   @default(false)
  hidden      Boolean   @default(false)
  /// ຈັດການແລ້ວ (ຕອບແລ້ວ / ບໍ່ຕ້ອງຕອບ)
  handled     Boolean   @default(false)
  handledAt   DateTime?
  assignee    String?
  leadId      String?
  commentedAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  post FbPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  page FbPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lead Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([pageId, commentedAt])
  @@index([postId])
  @@index([handled])
}

/// ຫ້ອງແຊັດ 1 ຄົນ (Messenger conversation)
model FbThread {
  id            String    @id @default(cuid())
  fbThreadId    String    @unique
  pageId        String
  /// PSID ຂອງຄົນທັກ — ໃຊ້ສົ່ງຂໍ້ຄວາມກັບ
  psid          String?
  personName    String?
  snippet       String?
  messageCount  Int       @default(0)
  unreadCount   Int       @default(0)
  /// ຂໍ້ຄວາມສຸດທ້າຍມາຈາກລູກຄ້າ (ຍັງບໍ່ໄດ້ຕອບ)
  waitingReply  Boolean   @default(false)
  handled       Boolean   @default(false)
  handledAt     DateTime?
  assignee      String?
  leadId        String?
  lastMessageAt DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  page     FbPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lead     Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages FbMessage[]

  @@index([pageId, lastMessageAt])
  @@index([handled])
}

/// ຂໍ້ຄວາມໃນຫ້ອງແຊັດ — ເກັບໄວ້ອ່ານຍ້ອນຫຼັງ ແລະ ຮູ້ວ່າໃຜເວົ້າສຸດທ້າຍ
model FbMessage {
  id          String   @id @default(cuid())
  fbMessageId String   @unique
  threadId    String
  fromPage    Boolean  @default(false)
  fromId      String?
  fromName    String?
  text        String?
  attachment  String?
  sentAt      DateTime
  createdAt   DateTime @default(now())

  thread FbThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
}

/// ຕັ້ງຄ່າທົ່ວໄປ (key/value) — ເກັບ token, ຄ່າ default ຕ່າງໆ
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// ບັນທຶກການ sync ຈາກ Facebook API
/// ແລ່ນເບື້ອງຫຼັງ ແລະ ແບ່ງດຶງເທື່ອລະອາທິດ — `doneDays/totalDays` ຄືຄວາມຄືບໜ້າ
/// ທີ່ໜ້າຕັ້ງຄ່າດຶງໄປສະແດງ. `updatedAt` ໃຊ້ກວດວ່າວຽກຄ້າງ (ເຊີບເວີດັບກາງຄັນ)
model SyncLog {
  id          String     @id @default(cuid())
  startedAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  finishedAt  DateTime?
  status      SyncStatus @default(RUNNING)
  level       String?
  dateFrom    DateTime?  @db.Date
  dateTo      DateTime?  @db.Date
  recordCount Int        @default(0)
  /// ຈຳນວນວັນທັງໝົດທີ່ຕ້ອງດຶງ ແລະ ດຶງແລ້ວ — ໃຊ້ສະແດງແຖບຄວາມຄືບໜ້າ
  totalDays   Int        @default(0)
  doneDays    Int        @default(0)
  /// ວຽກນີ້ຖືກເລີ່ມໂດຍຕົວຕັ້ງເວລາ (ບໍ່ແມ່ນຄົນກົດປຸ່ມ) — ໃຊ້ແຍກໃນປະຫວັດ
  auto        Boolean    @default(false)
  message     String?

  @@index([startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ຜູ້ໃຊ້ ແລະ ບັນທຶກການກະທຳ
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // ຈັດການຜູ້ໃຊ້ ແລະ ຄ່າຕັ້ງໄດ້
  MEMBER // ໃຊ້ງານທົ່ວໄປ
}

/// ຜູ້ໃຊ້ຂອງລະບົບ.
///
/// ບໍ່ມີແຖວໃດເລີຍ = ລະບົບຍັງໃຊ້ລະຫັດຜ່ານດຽວຮ່ວມກັນຈາກ `APP_PASSWORD`
/// (ຮ້ານທີ່ຕິດຕັ້ງໄວ້ກ່ອນຈຶ່ງໃຊ້ຕໍ່ໄດ້ໂດຍບໍ່ຕ້ອງແກ້ຫຍັງ).
/// ພໍສ້າງຜູ້ໃຊ້ຄົນທຳອິດ ລະບົບຈະບັງຄັບໃຫ້ login ດ້ວຍຊື່ + ລະຫັດແທນ.
model User {
  id           String   @id @default(cuid())
  /// ຊື່ທີ່ໃຊ້ເຂົ້າລະບົບ — ຕົວພິມນ້ອຍ ບໍ່ມີຊ່ອງຫວ່າງ
  name         String   @unique
  /// ຊື່ທີ່ສະແດງໃນບັນທຶກການກະທຳ
  displayName  String
  /// PBKDF2 — ຮູບແບບ "pbkdf2$<ຮອບ>$<salt>$<hash>" (ເບິ່ງ `src/lib/password.ts`)
  passwordHash String
  role         UserRole @default(MEMBER)
  /// ປິດແທນການລຶບ — ບັນທຶກການກະທຳຈະໄດ້ຍັງອ້າງເຖິງໄດ້
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([active])
}

/// ບັນທຶກການກະທຳທີ່ **ກູ້ຄືນບໍ່ໄດ້ ຫຼື ມີຜົນກັບເງິນ**.
///
/// ບໍ່ໄດ້ບັນທຶກທຸກຢ່າງ — ບັນທຶກໝົດຈະບໍ່ມີໃຜອ່ານ. ເອົາສະເພາະ:
/// ການລຶບ, ການສັ່ງໄປ Facebook (ຢຸດ/ຍິງຕໍ່, ປ່ຽນງົບ) ແລະ ການປ່ຽນຄ່າຕັ້ງສຳຄັນ.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  /// ຊື່ຜູ້ໃຊ້ຕອນນັ້ນ — ເກັບໄວ້ຕ່າງຫາກ ເພື່ອໃຫ້ອ່ານໄດ້ເຖິງແມ່ນຜູ້ໃຊ້ຖືກລຶບ
  userName String
  /// ປະເພດ ເຊັ່ນ "campaign.delete", "campaign.budget", "settings.token"
  action   String
  /// ສິ່ງທີ່ຖືກເຮັດ — ຊື່ທີ່ຄົນອ່ານອອກ
  target   String?
  detail   String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([userId])
  @@index([action])
}
